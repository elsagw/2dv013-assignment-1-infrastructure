# Ansible inventory file for assignment 1
# This file will be populated by deploy.sh script using terraform outputs

[webservers]
webserver1 ansible_host=WEBSERVER1_IP
webserver2 ansible_host=WEBSERVER2_IP

[loadbalancer]
loadbalancer ansible_host=LOADBALANCER_PRIVATE_IP

[all:vars]
# SSH configuration
ansible_user=ubuntu
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# Port configurations for the assignment
webserver_port=80
loadbalancer_port=8082

# Load balancer needs to know webserver IPs for nginx config
webserver1_ip=WEBSERVER1_IP
webserver2_ip=WEBSERVER2_IP
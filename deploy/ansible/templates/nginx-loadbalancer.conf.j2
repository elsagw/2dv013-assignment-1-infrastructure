# Nginx load balancer configuration
# This file is managed by Ansible - do not edit manually

# Define upstream servers (webserver pool)
upstream webservers {
    # Round-robin load balancing (default)
    server {{ webserver1_ip }}:{{ webserver_port }};
    server {{ webserver2_ip }}:{{ webserver_port }};
}

# Server block for load balancer
server {
    # Listen on the load balancer port
    listen {{ loadbalancer_port }};
    
    # Server name (optional)
    server_name _;
    
    # Main location block - proxy to webservers
    location / {
        # Pass requests to upstream webservers
        proxy_pass http://webservers;
        
        # Preserve original headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Connection settings
        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        
        # Buffering settings for better performance
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }
    
    # Health check endpoint (optional but useful)
    location /health {
        access_log off;
        return 200 "Load balancer is healthy\n";
        add_header Content-Type text/plain;
    }
    
    # Status page (optional - for monitoring)
    location /status {
        access_log off;
        return 200 "Load balancer status: Active\nUpstream servers: 2\n";
        add_header Content-Type text/plain;
    }
}